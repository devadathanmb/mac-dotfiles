.DS_Store
ansible/.ansible/
untracked/*
*env*
**/logs
**/logs/
**/log
**/log/
**/history
*.log
.ruff_cache/
.cursor/*
.claude/*
.commandcode/
.sisyphus/*
configs/codex/config.toml
configs/zoxide/db.zo
configs/mpv/watch_later/

# Zed's local prompt library database and lock files are application state.
configs/zed/prompts/

# Private agent skills (local only; name them private-<name>)
configs/agents/skills/private-*/

# Obsidian third-party code is downloaded into the vault; only settings belong here.
configs/obsidian/plugins/*/*
!configs/obsidian/plugins/*/data.json
!configs/obsidian/plugins/global-vim-navigation/*
