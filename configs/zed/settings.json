// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
    // Keep this map in sync with configs/zed/extensions.txt.
    "auto_install_extensions": {
        "astro": true,
        "dockerfile": true,
        "github-theme": true,
        "html": true,
        "make": true,
        "material-icon-theme": true,
        "mdx": true
    },
    // ─── Font ────────────────────────────────────────────────────────────────────
    "icon_theme": "Material Icon Theme",
    "cli_default_open_behavior": "existing_window",
    "diff_view_style": "split",
    "edit_predictions": {
        "provider": "copilot",
    },
    "auto_update": true,
    "agent_ui_font_size": 16,
    "agent_buffer_font_size": 15.5,
    "buffer_font_family": "Maple Mono NF",
    // Visually compensate for Zed lacking VS Code's tightened letter spacing.
    "buffer_font_size": 15.5,
    "buffer_font_weight": 500,
    // Preserve VS Code's effective 25.2px line height independently of glyph size.
    "buffer_line_height": { "custom": 1.62580645 },
    // Zed has no equivalent to VS Code's editor.letterSpacing (-0.67px).
    "ui_font_family": "Maple Mono NF",
    "ui_font_size": 16,
    "ui_font_weight": 500,
    "ui_font_features": {
        "calt": true,
        "cv01": true,
        "zero": true,
        "cv61": true,
    },
    // Keep repository metadata out of scans, but allow opening local env files.
    "file_scan_exclusions": [
        "**/.git",
        "**/.svn",
        "**/.hg",
        "**/.jj",
        "**/.sl",
        "**/.repo",
        "**/CVS",
        "**/.DS_Store",
        "**/Thumbs.db",
        "**/.classpath",
        "**/.factorypath",
        "**/.project",
        "**/.settings",
    ],
    "file_scan_inclusions": [".env*", "**/.env", "**/.env.*"],
    // The closest supported equivalent to VS Code's search.followSymlinks=false.
    "scan_symlinks": "expanded",
    "project_panel": {
        "dock": "left",
        "entry_spacing": "standard",
        "indent_size": 14,
        "indent_guides": { "show": "always" },
        "auto_reveal_entries": true,
        "auto_fold_dirs": true,
        "file_icons": true,
        "git_status": true,
        "hide_hidden": false,
        "show_diagnostics": "all",
    },
    "toolbar": {
        "breadcrumbs": false,
        "quick_actions": false,
    },
    "outline_panel": {
        "dock": "left",
    },
    "collaboration_panel": {
        "dock": "left",
    },
    "agent": {
        "default_model": {
            "effort": "high",
            "provider": "copilot_chat",
            "model": "claude-sonnet-4.6",
            "enable_thinking": true,
        },
        "dock": "right",
        "favorite_models": [],
        "model_parameters": [],
    },
    "git_panel": {
        "dock": "left",
    },
    "file_finder": {
        "modal_max_width": "large",
        "include_ignored": "smart",
    },
    "search": {
        "include_ignored": false,
        "case_sensitive": false,
        "whole_word": false,
        "regex": false,
        "search_on_type": true,
    },
    "agent_servers": {
        "github-copilot-cli": {
            "type": "registry",
        },
        "opencode": {
            "default_config_options": {
                "effort": "high",
                "model": "opencode/x-preview-f-free"
            },
            "type": "registry",
        },
        "auggie": {
            "type": "registry",
        },
        "cursor": {
            "type": "registry",
        },
        "codex-acp": {
            "type": "registry",
        },
        "claude-acp": {
            "type": "registry",
        },
    },
    "buffer_font_features": {
        "calt": true,
        "cv01": true,
        "zero": true,
        "cv61": true,
    },

    // ─── Editor ──────────────────────────────────────────────────────────────────
    // "combined" layers LSP semantic tokens on top of tree-sitter highlights
    "semantic_tokens": "combined",
    "colorize_brackets": true,
    "relative_line_numbers": "enabled",
    "cursor_blink": true,
    "soft_wrap": "editor_width",
    "close_panel_on_toggle": true,
    "show_whitespaces": "boundary",
    "tab_size": 4,
    "hard_tabs": false,
    "minimap": {
        "show": "never",
    },
    "scrollbar": {
        "diagnostics": "all",
        "axes": {
            "horizontal": false,
            "vertical": true,
        },
    },

    // Native Error Lens equivalent; match VS Code's short debounce.
    "diagnostics": {
        "button": true,
        "include_warnings": true,
        "inline": {
            "enabled": true,
            "update_debounce_ms": 10,
            "max_severity": null,
        },
    },

    // ─── Theme ───────────────────────────────────────────────────────────────────
    "theme": {
        "mode": "system",
        "light": "One Light",
        "dark": "GitHub Dark",
    },
    "theme_overrides": {
        // Match GitHub Dark Default and workbench.colorCustomizations in VS Code.
        "GitHub Dark": {
            "background": "#000000",
            "editor.background": "#000000",
            "editor.gutter.background": "#000000",
            "editor.foreground": "#d7d8da",
            "editor.active_line.background": "#6e76811a",
            "editor.highlighted_line.background": "#6e76811a",
            "editor.line_number": "#6e7681",
            "editor.active_line_number": "#e6edf3",
            "editor.invisible": "#343333",
            "editor.indent_guide": "#e6edf31f",
            "editor.indent_guide_active": "#e6edf33d",
            "editor.document_highlight.read_background": "#6e768180",
            "editor.document_highlight.write_background": "#6e76814d",
            "editor.document_highlight.bracket_background": "#3fb95040",
            "toolbar.background": "#000000",
            "tab_bar.background": "#000000",
            "tab.active_background": "#21262d",
            "tab.inactive_background": "#000000",
            "status_bar.background": "#0d1117",
            "title_bar.background": "#0d1117",
            "title_bar.inactive_background": "#010409",
            "panel.background": "#010409",
            "surface.background": "#010409",
            "elevated_surface.background": "#161b22",
            "border": "#30363d",
            "border.variant": "#30363d",
            "pane.focused_border": "#30363d",
            "panel.focused_border": "#30363d",
            "text": "#E1E4E8",
            "text.muted": "#7d8590",
            "text.placeholder": "#7d8590",
            "icon": "#e6edf3",
            "icon.muted": "#7d8590",
            "hint": "#656D71",
            "ignored": "#7d8590",
            "created": "#4AE04A",
            "deleted": "#FF6B6B",
            "modified": "#E2C08D",
            "renamed": "#4AE04A",
            "scrollbar.thumb.background": "#8b949e33",
            "scrollbar.thumb.hover_background": "#8b949e3d",
            "terminal.foreground": "#e6edf3",
            "terminal.ansi.black": "#484f58",
            "terminal.ansi.bright_black": "#6e7681",
            "terminal.ansi.magenta": "#bc8cff",
            "terminal.ansi.white": "#b1bac4",
            "syntax": {
                "comment": {
                    "color": "#8b949e",
                    "font_style": "italic",
                },
                "comment.doc": {
                    "color": "#8b949e",
                    "font_style": "italic",
                },
                "primary": { "color": "#d7d8da" },
                "variable": { "color": "#e6edf3" },
                "property": { "color": "#79c0ff" },
                "punctuation": { "color": "#e6edf3" },
                "punctuation.bracket": { "color": "#e6edf3" },
                "punctuation.delimiter": { "color": "#e6edf3" },
                "keyword": { "color": "#ff7b72" },
                "operator": { "color": "#ff7b72" },
                "function": { "color": "#d2a8ff" },
                "function.method": { "color": "#d2a8ff" },
                "string": { "color": "#a5d6ff" },
                "number": { "color": "#79c0ff" },
                "boolean": { "color": "#79c0ff" },
                "type": { "color": "#ffa657" },
                "type.builtin": { "color": "#79c0ff" },
            },
        },
    },

    // ─── Inlay Hints ─────────────────────────────────────────────────────────────
    "inlay_hints": {
        "enabled": true,
        "show_value_hints": true,
        "show_type_hints": true,
        "show_parameter_hints": true,
        "show_other_hints": true,
        "show_background": false,
        "edit_debounce_ms": 700,
        "scroll_debounce_ms": 50,
        "toggle_on_modifiers_press": {
            "control": false,
            "alt": false,
            "shift": false,
            "platform": false,
            "function": false,
        },
    },

    // ─── Telemetry ───────────────────────────────────────────────────────────────
    "telemetry": {
        "diagnostics": false,
        "metrics": false,
    },

    // ─── Vim ─────────────────────────────────────────────────────────────────────
    "vim_mode": true,
    "vim": {
        "use_system_clipboard": "always",
        "highlight_on_yank_duration": 200,
        "use_smartcase_find": true,
        // Keep line numbers relative at all times (no toggle on mode change)
        "toggle_relative_line_numbers": false,
    },

    // ─── Keymap Base ─────────────────────────────────────────────────────────────
    "base_keymap": "Cursor",

    // ─── WhichKey ────────────────────────────────────────────────────────────────
    "which_key": {
        "enabled": true,
        "delay_ms": 500,
    },

    // ─── LSP ───────────────────────────────────────────────────────────────────
    // Zed's default Python LS is basedpyright (see https://zed.dev/docs/languages/python).
    // Use lsp.basedpyright… — lsp.pyright only applies if you enable the "pyright" language server.
    "lsp": {
        "basedpyright": {
            "settings": {
                "basedpyright.analysis": {
                    "autoImportCompletions": true,
                    "diagnosticSeverityOverrides": {
                        "reportReturnType": "warning",
                        "reportGeneralTypeIssues": "warning",
                        "reportInvalidTypeForm": "error",
                        "reportOptionalMemberAccess": "none",
                        "reportAssignmentType": "none",
                        "reportOptionalSubscript": "none",
                        "reportAttributeAccessIssue": "none",
                        "reportUnknownMemberType": "none",
                        "reportArgumentType": "none",
                    },
                },
            },
        },
        "vtsls": {
            "settings": {
                "typescript": {
                    "inlayHints": {
                        "parameterNames": {
                            "enabled": "none",
                        },
                        "parameterTypes": {
                            "enabled": false,
                        },
                        "variableTypes": {
                            "enabled": false,
                        },
                        "propertyDeclarationTypes": {
                            "enabled": false,
                        },
                        "functionLikeReturnTypes": {
                            "enabled": false,
                        },
                        "enumMemberValues": {
                            "enabled": false,
                        },
                    },
                },
            },
        },
    },

    // ─── Git ─────────────────────────────────────────────────────────────────────
    "git": {
        "inline_blame": {
            "enabled": true,
        },
    },

    // ─── Terminal ────────────────────────────────────────────────────────────────
    "terminal": {
        "dock": "bottom",
        "working_directory": "current_project_directory",
        "max_scroll_history_lines": 5000,
        "font_family": "Maple Mono NF",
        "font_size": 15.5,
        "font_weight": 500,
        "font_features": {
            "calt": true,
            "cv01": true,
            "zero": true,
            "cv61": true,
        },
        "line_height": { "custom": 1.63100903 },
        "shell": {
            "program": "fish",
        },
    },

    // ─── Language Overrides ──────────────────────────────────────────────────────
    "languages": {
        "TypeScript": {
            "format_on_save": "off",
        },
        "Python": {
            "tab_size": 4,
            "format_on_save": "off",
            // Zed's default Python pipeline runs ruff `source.organizeImports`
            // BEFORE the configured formatter. Empty this out so only Black
            // touches the file — otherwise ruff reorders imports and you see
            // changes that look like "something other than black" is running.
            // See: https://zed.dev/docs/languages/python#configuring-formatting
            "code_actions_on_format": {
                "source.organizeImports.ruff": false,
            },
            "formatter": {
                "external": {
                    "command": "black",
                    "arguments": ["--stdin-filename", "{buffer_path}", "-"],
                },
            },
        },

        // YAML / Docker Compose use 2-space indentation
        "YAML": {
            "tab_size": 2,
        },
    },
}
