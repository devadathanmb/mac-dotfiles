CONFIG_GUM_FILTER_OPTS="--prompt.foreground #71b7ff --indicator.foreground #71b7ff --selected-indicator.foreground #71b7ff --unselected-prefix.foreground #7a828e --header.foreground #71b7ff --text.foreground #f0f3f6 --cursor-text.foreground #f0f3f6 --match.foreground #71b7ff --placeholder.foreground #7a828e  --prompt  > --indicator ◆ --selected-prefix  ◉  --unselected-prefix  ○  --placeholder こんにちは..."
CONFIG_GUM_INPUT_OPTS="--prompt.foreground #71b7ff --cursor.foreground #f0f3f6 --placeholder こんにちは... --cursor.mode blink"
CONFIG_GUM_PAGER_OPTS="--foreground #f0f3f6 --line-number.foreground #7a828e --match.foreground #71b7ff --match-highlight.foreground #0a0c10 --match-highlight.background #71b7ff --help.foreground #7a828e --show-line-numbers --soft-wrap --border-foreground #71b7ff"
CONFIG_GUM_SPIN_OPTS="--spinner dot --spinner.foreground #71b7ff --title.foreground #7a828e  --align left"
CONFIG_GUM_CONFIRM_OPTS="--prompt.foreground #71b7ff --selected.foreground #0a0c10 --selected.background #71b7ff --unselected.foreground #7a828e"

