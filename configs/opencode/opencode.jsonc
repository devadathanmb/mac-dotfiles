{
  "$schema": "https://opencode.ai/config.json",
  "model": "openai/gpt-6-luna",
  "update": "notify",
  "share": "disabled",
  "disabled_providers": [],
  "tool_output": {
    "max_lines": 500,
    "max_bytes": 20000
  },
  "agents": {
    "title": {
      "model": "opencode/big-pickle"
    },
    "explore": {
      "model": "openai/gpt-5.6-luna#high"
    },
    "general": {
      "model": "openai/gpt-5.6-terra#high"
    }
  },
  "experimental": {
    "disable_paste_summary": true
  },
  "compaction": {
    "auto": true,
    "buffer": 10000
  },
  "formatter": false,
  "lsp": false,
  // "lsp": {
  //   "pyright": {
  //     "disabled": true
  //   }
  // },
  "mcp": {
    "servers": {
      "context7": {
        "type": "remote",
        "url": "https://mcp.context7.com/mcp"
      },
      "deepwiki": {
        "type": "remote",
        "url": "https://mcp.deepwiki.com/mcp",
        "disabled": true
      },
      "exa": {
        "type": "remote",
        "url": "https://mcp.exa.ai/mcp",
        "headers": {
          "x-api-key": "{file:~/.secrets/exa-api-key}"
        }
      },
      "grep_app": {
        "type": "remote",
        "url": "https://mcp.grep.app",
        "disabled": true
      }
    }
  },
  "permissions": [
    {
      "action": "skill",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "external_directory",
      "resource": "$HOME/.mac-dots/configs/agents/*",
      "effect": "allow"
    },
    {
      "action": "external_directory",
      "resource": "/tmp/agent-gh/**",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "aws*",
      "effect": "ask"
    },
    {
      "action": "shell",
      "resource": "*rm *",
      "effect": "ask"
    }
  ],
  // OpenCode Quota: tuiCommandDisplay chooses whether native TUI command output appears in the session transcript or a local popup dialog.
  // OpenCode Quota: loads the server plugin for slash commands and quota checks.
  "plugins": [
    // "@slkiser/opencode-quota@latest",
    // "@mohak34/opencode-notifier@0.2.8"
  ],
  "providers": {
    // Detected openai authentication; opencode-quota added this global provider declaration.
    "openai": {}
  }
}
