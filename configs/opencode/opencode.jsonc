{
  "$schema": "https://opencode.ai/config.json",
  "model": "openai/gpt-5.6-luna",
  "small_model": "opencode/deepseek-v4-flash-free",
  "autoupdate": "notify",
  "share": "disabled",
  "lsp": false,
  "tool_output": {
    "max_lines": 500,
    "max_bytes": 20000
  },
  "experimental": {
    "openTelemetry": false,
    "disable_paste_summary": true
  },
  "compaction": {
    "auto": true,
    "prune": true,
    "reserved": 10000
  },
  "formatter": false,
  "plugin": [],
  "agent": {
    "explore": {
      "model": "openai/gpt-5.6-luna",
      "variant": "low"
    },
    "general": {
      "model": "openai/gpt-5.6-terra",
      "variant": "medium"
    }
  },
  "mcp": {
    "exa": {
      "type": "remote",
      "url": "https://mcp.exa.ai/mcp?tools=web_search_exa,get_code_context_exa,crawling_exa",
      "enabled": true,
      "headers": {
        "x-api-key": "{file:~/.secrets/exa-api-key}"
      }
    },
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "headers": {
        "CONTEXT7_API_KEY": "{file:~/.secrets/context7-api-key}"
      }
    },
    "gh_grep": {
      "type": "remote",
      "url": "https://mcp.grep.app",
      "enabled": false
    },
    "deepwiki": {
      "type": "remote",
      "url": "https://mcp.deepwiki.com/mcp"
    },
    "playwright": {
      "type": "local",
      "command": ["npx", "-y", "@playwright/mcp"],
      "enabled": false
    }
  },
  "permission": {
    "bash": {
      "gh * create*": "ask",
      "gh * edit*": "ask",
      "git push *--force": "ask",
      "git push *--force *": "ask",
      "git push -f": "ask",
      "git push -f *": "ask",
      "git push * -f": "ask",
      "git push * -f *": "ask",
      "git push +*": "ask",
      "git push * +*": "ask",
      "git branch -D": "ask",
      "git branch -D *": "ask",
      "git push --delete *": "ask",
      "git push * --delete *": "ask",
      "git reset --hard": "ask",
      "git reset --hard *": "ask",
      "git clean -f *": "ask",
      "git clean -fd *": "ask",
      "git clean -fdx *": "ask",
      "rm *": "ask",
      "sudo *": "ask",
      "aws*": "ask",
      "wangler*": "ask"
    }
  }
}
