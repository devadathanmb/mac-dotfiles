{
  "$schema": "https://opencode.ai/v2/cli.json",
  "theme": {
    "name": "opencode-black",
    "mode": "system"
  },
  "diffs": {
    "wrap": "word",
    "single": false,
    "view": "auto"
  },
  "keybinds": {
    "input.newline": "shift+return",
    "input.submit": "return"
  },
  "leader": {
    "timeout": 1000
  },
  "session": {
    "verbosity": "high",
    "sidebar": "hide",
    "scrollbar": false,
    "thinking": "show",
    "image_preview": true,
    "markdown": "rendered",
    "grouping": "none",
    "tps": true,
    "permissions": "prompt"
  },
  "animations": true,
  "tabs": {
    "layout": "vertical",
    "indicators": "status",
    "mode": "off"
  },
  "attention": {
    "notifications": false,
    "sound": true
  },
  "prompt": {
    "paste": "full",
    "image_preview": true
  },
  "terminal": {
    "copy": "select"
  },
  "mini": {
    "mono": false
  },
  "scroll": {
    "acceleration": true
  },
  "debug": {
    "devtools": false
  }
}
