{
  "defaultProvider": "openai-codex",
  "defaultModel": "gpt-5.6-sol",
  "defaultThinkingLevel": "high",
  "lastChangelogVersion": "0.84.1",
  "theme": "custom-github-dark",
  "packages": [
    "npm:pi-mcp-adapter",
    "npm:pi-subagents@0.45.0"
