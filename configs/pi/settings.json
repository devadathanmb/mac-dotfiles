        "thinking": "medium"
      },
      "worker": {
        "model": "openai-codex/gpt-5.6-terra",
        "thinking": "high"
      },
      "reviewer": {
        "model": "openai-codex/gpt-5.6-sol",
        "thinking": "high"
      },
      "oracle": {
        "model": "openai-codex/gpt-5.6-sol",
        "thinking": "high"
      }
    }
  }
